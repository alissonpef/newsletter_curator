<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Hermes · Dashboard editorial para newsletters financeiras">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="/static/dashboard.css">
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-block">
          <div class="brand-mark">H</div>
          <div>
            <p class="eyebrow">Briefing Executivo</p>
            <h1>Hermes</h1>
          </div>
        </div>
        <div class="topbar-meta">
          <div>
            <span class="meta-label">Atualização</span>
            <strong id="generated-at">-</strong>
          </div>
          <div class="status-live">
            <span class="status-live-dot"></span>
            <span>Dashboard online</span>
          </div>
        </div>
      </header>

      <aside class="calendar-panel">
        <div class="panel-head">
          <div>
            <p class="eyebrow">Cobertura</p>
            <h2>Últimas semanas</h2>
          </div>
          <div id="calendar-stats" class="mini-stats"></div>
        </div>
        <div id="calendar-weeks" class="calendar-weeks"></div>
      </aside>

      <main class="content-panel">
        <section id="hero-strip" class="hero-strip"></section>
        <section id="digest-content" class="digest-grid"></section>
      </main>

      <aside class="action-panel">
        <section class="card action-card">
          <div class="panel-head">
            <div>
              <p class="eyebrow">Execução</p>
              <h2>Gerar edição</h2>
            </div>
          </div>
          <label class="field-label" for="date-picker">Data da edição</label>
          <input id="date-picker" class="date-input" type="date">
          <div class="button-row">
            <button id="generate-button" class="btn btn-primary" type="button">Gerar</button>
            <button id="force-button" class="btn btn-secondary" type="button">Regenerar</button>
          </div>
          <div id="job-banner" class="job-banner"></div>
          <div id="job-progress" class="progress-wrap"></div>
        </section>

        <section class="card">
          <div class="panel-head">
            <div>
              <p class="eyebrow">Entrega</p>
              <h2>Kindle</h2>
            </div>
          </div>
          <label class="field-label" for="kindle-email">E-mail do Kindle</label>
          <input id="kindle-email" class="text-input" type="email" placeholder="seu-dispositivo@kindle.com">
          <p id="kindle-hint" class="helper-text"></p>
          <button id="kindle-button" class="btn btn-ghost" type="button">Enviar PDF para Kindle</button>
        </section>

        <section class="card">
          <div class="panel-head">
            <div>
              <p class="eyebrow">Mercado</p>
              <h2>Radar</h2>
            </div>
          </div>
          <div id="market-radar" class="market-stack"></div>
        </section>

        <section id="player-panel" class="card" hidden>
          <div class="panel-head">
            <div>
              <p class="eyebrow">Áudio</p>
              <h2>Podcast</h2>
            </div>
          </div>
          <audio id="audio-player" controls preload="metadata"></audio>
        </section>

        <section id="downloads-panel" class="card" hidden>
          <div class="panel-head">
            <div>
              <p class="eyebrow">Arquivos</p>
              <h2>Downloads</h2>
            </div>
          </div>
          <div id="download-links" class="download-stack"></div>
        </section>
      </aside>
    </div>

    <script>
      window.__HERMES_STATE__ = {{ state_payload | tojson }};
    </script>
    <script src="/static/dashboard.js" defer></script>
  </body>
</html>
